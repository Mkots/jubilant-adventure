{
    "name": "@jubilant-adventure/api",
    "version": "0.1.0",
    "private": true,
    "description": "HTTP server for the jubilant-adventure test lab.",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "start": "tsx src/index.ts",
        "test": "vitest run --config vitest.config.mts",
        "test:watch": "vitest --config vitest.config.mts",
        "test:coverage": "vitest run --config vitest.config.mts --coverage",
        "ci:coverage": "vitest --config vitest.config.mts --reporter=junit --outputFile=../../test-report.api.junit.xml --coverage",
        "type-check": "tsc --noEmit",
        "export:openapi": "tsx scripts/export-openapi.ts",
        "db:generate": "drizzle-kit generate --config drizzle.config.ts",
        "db:check": "drizzle-kit check --config drizzle.config.ts",
        "db:migrate": "tsx scripts/migrate.ts",
        "db:test:schema": "tsx scripts/test-schema.ts"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.1",
        "@hono/swagger-ui": "^0.6.1",
        "@hono/zod-openapi": "^1.6.3",
        "@jubilant-adventure/shop-domain": "0.1.0",
        "@jubilant-adventure/test-data": "0.1.0",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/auto-instrumentations-node": "^0.80.0",
        "@opentelemetry/context-async-hooks": "^2.11.0",
        "@opentelemetry/core": "^2.11.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
        "@opentelemetry/resources": "^2.11.0",
        "@opentelemetry/sdk-node": "^0.222.0",
        "@opentelemetry/sdk-trace-base": "^2.11.0",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "@sentry/node": "^10.74.0",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.13.7",
        "pg": "^8.23.0",
        "prom-client": "^15.1.3",
        "zod": "^4.6.2"
    },
    "devDependencies": {
        "@apidevtools/swagger-parser": "^13.0.0",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.10"
    }
}
