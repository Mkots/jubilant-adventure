{
    "name": "@jubilant-adventure/web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "type-check": "tsc --noEmit",
        "preview": "vite preview",
        "test": "vitest run --config vitest.config.mts",
        "test:watch": "vitest --config vitest.config.mts",
        "test:coverage": "vitest run --config vitest.config.mts --coverage",
        "ci:coverage": "vitest run --config vitest.config.mts --reporter=junit --outputFile=../../test-report.web.junit.xml --coverage"
    },
    "dependencies": {
        "@jubilant-adventure/api-client": "0.1.0",
        "@reduxjs/toolkit": "latest",
        "react": "latest",
        "react-dom": "latest",
        "react-redux": "latest",
        "react-router-dom": "latest"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "latest",
        "@types/react-dom": "latest",
        "@vitejs/plugin-react": "latest",
        "jsdom": "^30.0.1",
        "msw": "^2.15.0",
        "vite": "latest"
    }
}
