{
    "name": "payment-replay",
    "request": {
        "method": "POST",
        "urlPath": "/payments/authorize",
        "headers": { "X-Payment-Scenario": { "equalTo": "replay" } }
    },
    "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "transformers": ["response-template"],
        "jsonBody": {
            "providerTransactionId": "{{request.headers.Idempotency-Key}}",
            "status": "authorized"
        }
    },
    "priority": 1
}
