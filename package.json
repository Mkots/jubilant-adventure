{
    "name": "jubilant-adventure",
    "version": "0.1.0",
    "private": true,
    "description": "TypeScript exercises and a small HTTP server.",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Mkots/jubilant-adventure.git"
    },
    "bugs": {
        "url": "https://github.com/Mkots/jubilant-adventure/issues"
    },
    "homepage": "https://github.com/Mkots/jubilant-adventure#readme",
    "license": "MIT",
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=11.0.0"
    },
    "scripts": {
        "start": "npm run start --workspace=@jubilant-adventure/api",
        "dev:web": "npm run dev --workspace=@jubilant-adventure/web",
        "storybook": "npm run storybook --workspace=@jubilant-adventure/web",
        "storybook:visual": "npm run storybook:visual --workspace=@jubilant-adventure/web",
        "build:storybook": "npm run build:storybook --workspace=@jubilant-adventure/web",
        "test:storybook": "npm run test:storybook --workspace=@jubilant-adventure/web",
        "test:mock-lab": "npm run test:mock-lab --workspace=@jubilant-adventure/web",
        "build:web": "npm run build --workspace=@jubilant-adventure/web",
        "type-check:web": "npm run type-check --workspace=@jubilant-adventure/web",
        "test": "npm run test --workspaces --if-present",
        "test:watch": "npm run test:watch --workspaces --if-present",
        "test:coverage": "npm run test:coverage --workspaces --if-present",
        "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
        "test:e2e:ui": "playwright test --config=tests/e2e/playwright.config.ts --ui",
        "test:e2e:headed": "playwright test --config=tests/e2e/playwright.config.ts --headed",
        "test:e2e:report": "playwright show-report tests/e2e/playwright-report",
        "test:visual": "playwright test --config=tests/visual/playwright.config.ts",
        "test:visual:update": "playwright test --config=tests/visual/playwright.config.ts --update-snapshots",
        "test:mutation:smoke": "stryker run --incremental --mutate 'packages/exercises/src/utils/isEven.ts'",
        "test:mutation": "stryker run",
        "test:allure": "tsx scripts/allure/run-allure.ts",
        "allure:generate": "allure generate artifacts/allure/results --output artifacts/allure/report",
        "test:allure-sanitizer": "vitest run --config tests/reporting/vitest.config.mts",
        "check:published-report": "tsx scripts/allure/check-published-report.ts",
        "test:design-exercises": "tsx scripts/test-design-exercises.ts",
        "defects:list": "tsx scripts/defects.ts list",
        "defects:verify": "tsx scripts/defects.ts verify",
        "test:api": "vitest run --config tests/api/vitest.config.mts",
        "test:schemathesis": "node scripts/run-schemathesis.mjs",
        "db:up": "docker compose --profile db up -d postgres",
        "db:reset": "docker compose --profile db down -v",
        "wiremock:up": "docker compose --profile testing up -d wiremock && node scripts/wait-for-wiremock.mjs",
        "wiremock:down": "docker compose --profile testing down",
        "test:wiremock": "vitest run --config tests/wiremock/vitest.config.mts",
        "env:test:up": "docker compose --profile performance up -d --build && node scripts/wait-for-api.mjs",
        "env:test:down": "docker compose --profile performance down -v",
        "env:resilience:up": "docker compose --profile resilience up -d --build && node scripts/wait-for-resilience.mjs",
        "env:resilience:down": "docker compose --profile resilience down -v",
        "test:performance:smoke": "node scripts/performance/run-k6.mjs smoke",
        "test:performance:average": "node scripts/performance/run-k6.mjs average",
        "test:integration:db": "vitest run --config tests/integration/vitest.config.mts",
        "test:api:postgres": "vitest run --config tests/integration/vitest.config.mts tests/integration/api-postgres.test.ts",
        "test:repositories": "vitest run --config tests/integration/vitest.config.mts tests/integration/repositories.test.ts",
        "test:payment-contract": "vitest run --config tests/payment/vitest.config.mts",
        "test:pact:consumer": "vitest run --config tests/pact/vitest.consumer.config.mts",
        "test:pact:provider": "vitest run --config tests/pact/vitest.provider.config.mts",
        "test:security:secrets": "node scripts/security/run-gitleaks.mjs",
        "test:security:trivy": "node scripts/security/run-trivy.mjs",
        "test:security:zap:baseline": "node scripts/security/run-zap.mjs baseline",
        "test:security:zap:active": "node scripts/security/run-zap.mjs active",
        "test:resilience:payment-timeout": "vitest run --config tests/resilience/vitest.config.mts",
        "sbom:generate": "node scripts/security/generate-sbom.mjs",
        "sbom:validate": "node scripts/security/validate-sbom.mjs",
        "type-check:e2e": "tsc --noEmit -p tests/e2e/tsconfig.json",
        "type-check:api": "tsc --noEmit -p tests/api/tsconfig.json",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "type-check": "npm run type-check --workspaces --if-present",
        "generate:api-client": "npm run export:openapi --workspace=@jubilant-adventure/api && node scripts/generate-api-client.mjs",
        "check:api-client": "npm run generate:api-client && git diff --exit-code -- packages/api-client/src/schema.ts packages/api-client/src/client.ts",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "prepare": "husky",
        "ci:biome": "biome ci .",
        "ci:coverage": "npm run ci:coverage --workspaces --if-present",
        "ci": "npm run type-check && npm run type-check:e2e && npm run type-check:api && npm run type-check:resilience && npm run ci:biome && npm run ci:coverage",
        "type-check:resilience": "tsc --noEmit -p tests/resilience/tsconfig.json"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "@pact-foundation/pact": "^17.1.4",
        "@playwright/test": "^1.63.0",
        "@stryker-mutator/core": "10.0.0",
        "@stryker-mutator/vitest-runner": "10.0.0",
        "@testcontainers/postgresql": "^12.1.0",
        "@types/node": "^26.4.1",
        "@vitest/coverage-v8": "^4.1.11",
        "allure": "3.17.0",
        "allure-js-commons": "3.12.1",
        "allure-playwright": "3.12.1",
        "allure-vitest": "3.12.1",
        "husky": "^9.1.7",
        "testcontainers": "^12.1.0",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "drizzle-kit": {
            "@esbuild-kit/core-utils": {
                "esbuild": "0.25.12"
            },
            "esbuild": "0.25.12"
        },
        "qs": "6.16.0"
    },
    "msw": {
        "workerDirectory": [
            "apps/web/public"
        ]
    }
}
